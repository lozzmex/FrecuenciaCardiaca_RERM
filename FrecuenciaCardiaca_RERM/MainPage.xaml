<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FrecuenciaCardiaca_RERM.MainPage">

    <ScrollView>

        <VerticalStackLayout
            Padding="30,30"
            Spacing="20">

            <Label
                Text="Frecuencia Cardiaca"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Ingresa los latidos detectados en 15 segundos"
                FontSize="18" />

            <Entry
                x:Name="Latidos"
                Placeholder="Cantidad de latidos"
                Keyboard="Numeric" />

            <Button
                Text="Calcular"
                Clicked="Button_Clicked" />

            <Label
                Text="Frecuencia cardiaca:"
                FontSize="18" />

            <Entry
                x:Name="Frecuencia"
                Placeholder="Latidos por minuto"
                IsReadOnly="True" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
